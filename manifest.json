{
  "manifest_version": 3,
  "name": "Tomanify by A.Z",
  "short_name": "Tomanify",
  "version": "2.3.4",
  "description": "Convert any price on the web to Iranian Toman. Reads the number next to the currency, including K/M suffixes.",
  "author": "Mohammad Alizade (A.Z)",
  "homepage_url": "https://github.com/mohamadaz-apps/tomanify",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tomanify by A.Z",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://alanchand.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["utils.js", "price-mind.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
